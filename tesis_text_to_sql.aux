\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Comparación entre Component Matching y Execution Accuracy para distintas configuraciones arquitectónicas. Esta gráfica permite visualizar que un alto Component Matching no garantiza, por sí solo, una ejecución correcta del SQL.}}{10}{figure.2}\protected@file@percent }
\newlabel{fig:component_matching_vs_execution}{{2}{10}{Comparación entre Component Matching y Execution Accuracy para distintas configuraciones arquitectónicas. Esta gráfica permite visualizar que un alto Component Matching no garantiza, por sí solo, una ejecución correcta del SQL}{figure.2}{}}
