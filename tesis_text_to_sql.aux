\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Correlación entre SIN\_AUTO\_CORRECCION y Time To Answer promedio. Se evidencia una relación inversa clara: las configuraciones con mayor capacidad de generación correcta en el primer intento presentan menores tiempos de respuesta, confirmando que la calidad inicial de la generación es determinante para la eficiencia temporal del sistema.}}{15}{figure.10}\protected@file@percent }
\newlabel{fig:correlacion_sin_ac}{{10}{15}{Correlación entre SIN\_AUTO\_CORRECCION y Time To Answer promedio. Se evidencia una relación inversa clara: las configuraciones con mayor capacidad de generación correcta en el primer intento presentan menores tiempos de respuesta, confirmando que la calidad inicial de la generación es determinante para la eficiencia temporal del sistema}{figure.10}{}}
