\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Exactitud de ejecución (Execution Accuracy) para las distintas configuraciones arquitectónicas evaluadas. Se observan diferencias sustanciales entre configuraciones, destacando el rol determinante de la recuperación contextual del esquema (RAG) en la generación de consultas SQL ejecutables.}}{10}{figure.3}\protected@file@percent }
\newlabel{fig:execution_accuracy}{{3}{10}{Exactitud de ejecución (Execution Accuracy) para las distintas configuraciones arquitectónicas evaluadas. Se observan diferencias sustanciales entre configuraciones, destacando el rol determinante de la recuperación contextual del esquema (RAG) en la generación de consultas SQL ejecutables}{figure.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {V-C}}Robustez ante errores considerando autocorrección (SIN ERRORES)}{10}{subsection.5.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Robustez del sistema considerando mecanismos de autocorrección (SIN ERRORES). Las configuraciones que incorporan RAG alcanzan valores cercanos al 100\%, evidenciando alta robustez frente a errores sintácticos y referencias incorrectas mediante corrección iterativa.}}{11}{figure.4}\protected@file@percent }
\newlabel{fig:sin_errores}{{4}{11}{Robustez del sistema considerando mecanismos de autocorrección (SIN ERRORES). Las configuraciones que incorporan RAG alcanzan valores cercanos al 100\%, evidenciando alta robustez frente a errores sintácticos y referencias incorrectas mediante corrección iterativa}{figure.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {V-D}}Capacidad real de generación sin autocorrección (SIN\_AUTO\_CORRECCION)}{11}{subsection.5.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Comparación de la capacidad de generación sin autocorrección (SIN\_AUTO\_CORRECCION) entre configuraciones. Se evidencia que la configuración [RAG + DIN + DEA] alcanza valores cercanos al 89\%, mientras que configuraciones basadas únicamente en RAG o Intensión dependen fuertemente de mecanismos de corrección iterativa.}}{11}{figure.5}\protected@file@percent }
\newlabel{fig:sin_autocorreccion}{{5}{11}{Comparación de la capacidad de generación sin autocorrección (SIN\_AUTO\_CORRECCION) entre configuraciones. Se evidencia que la configuración [RAG + DIN + DEA] alcanza valores cercanos al 89\%, mientras que configuraciones basadas únicamente en RAG o Intensión dependen fuertemente de mecanismos de corrección iterativa}{figure.5}{}}
